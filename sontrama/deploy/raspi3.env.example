# Example Pi 3 audio profile. Adjust the installation paths and device name.
SONTRAMA_HOST=0.0.0.0
SONTRAMA_PORT=8081
SONTRAMA_SOUNDFONTS=/usr/share/sounds/sf2:/home/pi/sontrama/data/soundfonts
SONTRAMA_STATE=/home/pi/sontrama/data/session.json
SONTRAMA_NATIVE_CACHE=/home/pi/sontrama/data/native
SONTRAMA_AUDIO_DEVICE=bcm2835 Headphones
SONTRAMA_BLOCK_SIZE=512
SONTRAMA_AUDIO_LATENCY=0.03
