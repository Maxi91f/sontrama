SONTRAMA_HOST=0.0.0.0
SONTRAMA_PORT=8081
SONTRAMA_SOUNDFONTS=/usr/share/sounds/sf2:/home/pi/sontrama/data/soundfonts
SONTRAMA_STATE=/home/pi/sontrama/data/session.json
SONTRAMA_NATIVE_CACHE=/home/pi/sontrama/data/native
# Use the device name shown by: uv run python -m sounddevice
# SONTRAMA_AUDIO_DEVICE=bcm2835 Headphones
SONTRAMA_BLOCK_SIZE=256
# Optional output buffering in seconds (or low/high):
# SONTRAMA_AUDIO_LATENCY=0.03
# Optional HTTPS for browser Web MIDI over LAN:
# SONTRAMA_TLS_CERT=/home/pi/sontrama/data/cert.pem
# SONTRAMA_TLS_KEY=/home/pi/sontrama/data/key.pem
